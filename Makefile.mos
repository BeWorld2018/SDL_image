# Makefile to build sdl2_image.library for MorphOS
#
#   make -f Makefile.mos                  library + SDK glue libraries
#   make -f Makefile.mos JPGPNG=stb       other JPEG/PNG backend (see below)
#   make -f Makefile.mos sdk              install header + glue libs in $(PREFIX)
#   make -f Makefile.mos install          copy the library to LIBS:
#
# JPEG/PNG backend, JPGPNG=
#   shared  (default) MorphOS system libraries, built with
#             -DUSE_SHAREDLIB_JPEG  jfif.library
#             -DUSE_SHAREDLIB_PNG   png.library V51
#             -DUSE_SHAREDLIB_TIF   tiff.library
#           They are opened by sdl2_image.library and are optional: if one
#           is missing, only that format fails.
#   stb     built-in stb_image decoder for JPEG/PNG, saving with
#           miniz / tiny_jpeg. TIFF still uses tiff.library.

JPGPNG ?= shared

PREFIX  = /gg/usr/local
CC      = ppc-morphos-gcc-9
AR      = ppc-morphos-ar
STRIP   = ppc-morphos-strip
OBJDUMP = ppc-morphos-objdump

# TODO: LOAD_JXL LOAD_AVIF
FORMATS = BMP GIF JPG LBM PCX PNG PNM QOI SVG TGA TIF WEBP XCF XPM XV

GLUEDEFS   = -DAROS_ALMOST_COMPATIBLE -DUSE_INLINE_STDARG
COMMONDEFS = $(GLUEDEFS) -D_NO_PPCINLINE

ifeq ($(JPGPNG),shared)
BACKENDDEFS = -DUSE_SHAREDLIB_JPEG -DUSE_SHAREDLIB_PNG -DUSE_SHAREDLIB_TIF
# Only jpeg_std_error()/png_init_io() live there and neither is used by the
# library: the jpeg_* / png_* calls go through the libaboxstubs glue.
BACKENDLIBS = -ljpeg_shared -lpng_shared
else ifeq ($(JPGPNG),stb)
BACKENDDEFS = -DUSE_STBIMAGE -DUSE_SHAREDLIB_TIF
BACKENDLIBS =
else
$(error JPGPNG must be shared or stb (got "$(JPGPNG)"))
endif

CDEFS = $(COMMONDEFS) $(BACKENDDEFS) $(addprefix -DLOAD_,$(FORMATS)) \
        -DSDL_IMAGE_SAVE_PNG=1 -DSDL_IMAGE_SAVE_JPG=1

INCLUDE = -I./include -I$(PREFIX)/include/SDL2 -I$(PREFIX)/include
CFLAGS  = -noixemul -mcpu=750 -mtune=7450 -O3 -mresident32 \
          -Wall -Wno-pointer-sign -fno-strict-aliasing -fomit-frame-pointer \
          $(INCLUDE) $(CDEFS)
DEPFLAGS = -MMD -MP

# -lGL: libSDL2.a(sdl-startup-brel.o) is needed for the varargs wrappers
# (SDL_SetError, SDL_sscanf, SDL_snprintf...) and references TinyGL.
LIBS = -L$(PREFIX)/lib -lSDL2 -lGL -lwebp -lwebpdemux $(BACKENDLIBS) -lm

AMIGADATE = $(shell date +"%-d.%-m.%Y")

ECHE = echo -e
BOLD = \033[1m
NRML = \033[22m

COMPILING = @$(ECHE) "compiling $(BOLD)$@$(NRML)..."
LINKING   = @$(ECHE) "linking $(BOLD)$@$(NRML)..."
STRIPPING = @$(ECHE) "stripping $(BOLD)$@$(NRML)..."
ARCHIVING = @$(ECHE) "archiving $(BOLD)$@$(NRML)..."
HEADERING = @$(ECHE) "creating headers files $(BOLD)$@$(NRML)..."

TARGET  = libSDL2_image.a
LIBRARY = sdl2_image.library

SOURCES = \
	src/IMG.c       \
	src/IMG_avif.c  \
	src/IMG_bmp.c   \
	src/IMG_gif.c   \
	src/IMG_jpg.c   \
	src/IMG_jxl.c   \
	src/IMG_lbm.c   \
	src/IMG_pcx.c   \
	src/IMG_png.c   \
	src/IMG_pnm.c   \
	src/IMG_qoi.c   \
	src/IMG_stb.c   \
	src/IMG_svg.c   \
	src/IMG_tga.c   \
	src/IMG_tif.c   \
	src/IMG_xcf.c   \
	src/IMG_xpm.c   \
	src/IMG_xv.c    \
	src/IMG_webp.c  \
	src/IMG_WIC.c   \
	src/IMG_xxx.c

OBJECTS     = $(SOURCES:.c=.o)
COREOBJECTS = $(patsubst %.c,%.o,$(wildcard MorphOS/*.c))
DEPS        = $(OBJECTS:.o=.d) $(COREOBJECTS:.o=.d)

# Rebuild everything when the backend or the flags change
BUILDSTAMP = .build-$(JPGPNG)

.PHONY: all sdklibs sdk headers install clean dump

all: $(LIBRARY) sdklibs

$(BUILDSTAMP):
	@rm -f .build-*
	@touch $@

src/%.o: src/%.c $(BUILDSTAMP)
	$(COMPILING)
	@$(CC) $(CFLAGS) $(DEPFLAGS) -o $@ -c $<

MorphOS/%.o: MorphOS/%.c $(BUILDSTAMP)
	$(COMPILING)
	@$(CC) $(CFLAGS) $(DEPFLAGS) -o $@ -c $<

# The library glue isn't resident code: it runs before r13 is set up.
# No -D_NO_PPCINLINE here: exec calls must stay inline, the libabox stubs
# linked with -mresident32 load SysBase through r13.
MorphOS/IMG_library.o: MorphOS/IMG_library.c $(BUILDSTAMP)
	$(COMPILING)
	@$(CC) -noixemul -mcpu=750 -Wall -fno-strict-aliasing $(INCLUDE) $(GLUEDEFS) $(BACKENDDEFS) \
		-D__AMIGADATE__=\"$(AMIGADATE)\" $(DEPFLAGS) -o $@ -c $<

$(TARGET): $(OBJECTS)
	$(ARCHIVING)
	@rm -f $@
	@$(AR) crs $@ $^

$(LIBRARY): $(TARGET) $(COREOBJECTS)
	$(LINKING)
	@$(CC) -noixemul -nostartfiles -mresident32 -Wl,-Map=sdl2_image.map \
		$(COREOBJECTS) -o $@.db -L. -lSDL2_image $(LIBS)
	$(STRIPPING)
	@$(STRIP) -o $@ --remove-section=.comment $@.db

sdklibs:
	@$(MAKE) -C MorphOS/devenv all

sdk: sdklibs
	mkdir -p $(PREFIX)/include/SDL2 $(PREFIX)/lib/libb32 $(PREFIX)/lib/pkgconfig
	mkdir -p $(addprefix $(PREFIX)/include/,fd clib proto ppcinline)
	cp include/SDL_image.h $(PREFIX)/include/SDL2/SDL_image.h
	cp MorphOS/sdk/fd/sdl2_image_lib.fd $(PREFIX)/include/fd/
	cp MorphOS/sdk/clib/sdl2_image_protos.h $(PREFIX)/include/clib/
	cp MorphOS/sdk/proto/sdl2_image.h $(PREFIX)/include/proto/
	cp MorphOS/sdk/ppcinline/sdl2_image.h $(PREFIX)/include/ppcinline/
	cp MorphOS/devenv/lib/libSDL2_image.a $(PREFIX)/lib/libSDL2_image.a
	cp MorphOS/devenv/lib/libb32/libSDL2_image.a $(PREFIX)/lib/libb32/libSDL2_image.a
	cp MorphOS/devenv/lib/libb32/libSDL2_image-nc.a $(PREFIX)/lib/libb32/libSDL2_image-nc.a
	cp SDL2_image.pc $(PREFIX)/lib/pkgconfig/SDL2_image.pc

headers:
	$(HEADERING)
	/gg/bin/cvinclude.pl --fd=MorphOS/sdk/fd/sdl2_image_lib.fd --clib=MorphOS/sdk/clib/sdl2_image_protos.h --proto=MorphOS/sdk/proto/sdl2_image.h
	/gg/bin/cvinclude.pl --fd=MorphOS/sdk/fd/sdl2_image_lib.fd --clib=MorphOS/sdk/clib/sdl2_image_protos.h --inline=MorphOS/sdk/ppcinline/sdl2_image.h

install: $(LIBRARY)
	@cp $(LIBRARY) LIBS:
	-flushlib $(LIBRARY)

# Test programs, linked against the glue library (run "make sdklibs" first)
APPFLAGS = -noixemul -O2 -Wall $(INCLUDE)
APPLIBS  = -LMorphOS/devenv/lib -lSDL2_image -L$(PREFIX)/lib -lSDL2 -lGL

testimage: test/main.c sdklibs
	$(CC) $(APPFLAGS) $(addprefix -DLOAD_,$(FORMATS)) test/main.c -o $@ \
		-LMorphOS/devenv/lib -lSDL2_image -L../SDL-release-2.32.x-MOS/test -lSDL2test -L$(PREFIX)/lib -lSDL2 -lGL

showanim: examples/showanim.c sdklibs
	$(CC) $(APPFLAGS) examples/showanim.c -o $@ $(APPLIBS)

showimage: examples/showimage.c sdklibs
	$(CC) $(APPFLAGS) examples/showimage.c -o $@ $(APPLIBS)

clean:
	rm -f $(LIBRARY) $(LIBRARY).db $(LIBRARY).s sdl2_image.map $(TARGET)
	rm -f $(OBJECTS) $(COREOBJECTS) $(DEPS) .build-*
	rm -f testimage showanim showimage
	@$(MAKE) -C MorphOS/devenv clean

dump:
	$(OBJDUMP) --disassemble-all --reloc $(LIBRARY).db >$(LIBRARY).s

-include $(DEPS)
